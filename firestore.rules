rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCentralViewer() {
      return signedIn()
        && (
          request.auth.uid == "Xjjdvk0Nx1eqCvND4yIOHbM53tl1"
          || request.auth.token.wonremoteViewer == true
        );
    }

    function deviceDoc(deviceId) {
      return get(/databases/$(database)/documents/devices/$(deviceId));
    }

    function hasFreshDeviceHeartbeat(deviceId) {
      let device = deviceDoc(deviceId).data;
      let heartbeatAt = device.get("lastSeenAtServer", null);
      return heartbeatAt is timestamp
        && heartbeatAt <= request.time
        && heartbeatAt >= request.time - duration.value(60, "s");
    }

    function ownsDevice(deviceId) {
      return signedIn() && deviceDoc(deviceId).data.ownerUid == request.auth.uid;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function deviceAccessLocked(deviceId) {
      return exists(/databases/$(database)/documents/deviceAccessLocks/$(deviceId))
        && get(/databases/$(database)/documents/deviceAccessLocks/$(deviceId)).data.enabled == true;
    }

    function protectedSessionAllows(deviceId, session) {
      return !deviceAccessLocked(deviceId)
        || (session.get("accessLockVersion", "") == get(/databases/$(database)/documents/deviceAccessLocks/$(deviceId)).data.version
          && session.state == "connected"
          && session.get("accessRequestId", "") is string
          && exists(/databases/$(database)/documents/deviceAccessRequests/$(session.get("accessRequestId", "")))
          && get(/databases/$(database)/documents/deviceAccessRequests/$(session.get("accessRequestId", ""))).data.state == "approved"
          && get(/databases/$(database)/documents/deviceAccessRequests/$(session.get("accessRequestId", ""))).data.operation == "connect"
          && get(/databases/$(database)/documents/deviceAccessRequests/$(session.get("accessRequestId", ""))).data.ownerUid == session.ownerUid
          && get(/databases/$(database)/documents/deviceAccessRequests/$(session.get("accessRequestId", ""))).data.deviceId == deviceId
          && get(/databases/$(database)/documents/deviceAccessRequests/$(session.get("accessRequestId", ""))).data.sessionId == session.id
          && get(/databases/$(database)/documents/deviceAccessRequests/$(session.get("accessRequestId", ""))).data.approvedVersion == session.accessLockVersion);
    }

    function ownsSession(sessionId) {
      return signedIn() && sessionDoc(sessionId).data.ownerUid == request.auth.uid;
    }

    function canAccessSession(sessionId) {
      return signedIn()
        && protectedSessionAllows(sessionDoc(sessionId).data.deviceId, sessionDoc(sessionId).data)
        && (
          sessionDoc(sessionId).data.ownerUid == request.auth.uid
          || (
            sessionDoc(sessionId).data.deviceId is string
            && deviceDoc(sessionDoc(sessionId).data.deviceId).data.ownerUid == request.auth.uid
          )
        );
    }

    function canReadSession() {
      return signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || (
            resource.data.deviceId is string
            && deviceDoc(resource.data.deviceId).data.ownerUid == request.auth.uid
          )
        );
    }

    function isOwnSessionCreate(sessionId) {
      return signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == sessionId
        && request.resource.data.deviceId is string
        && request.resource.data.state == "connected"
        && isCentralViewer()
        && deviceDoc(request.resource.data.deviceId).data.status == "online"
        && (deviceDoc(request.resource.data.deviceId).data.get("presenceMode", "periodic") == "manual"
          || hasFreshDeviceHeartbeat(request.resource.data.deviceId))
        && protectedSessionAllows(request.resource.data.deviceId, request.resource.data)
        && (!deviceAccessLocked(request.resource.data.deviceId)
          || get(/databases/$(database)/documents/deviceAccessRequests/$(request.resource.data.accessRequestId)).data.createdAt >= request.time - duration.value(120, "s"))
        && deviceDoc(request.resource.data.deviceId).data.ownerUid is string;
    }

    function isOwnSessionClose(sessionId) {
      return ownsSession(sessionId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.id == resource.data.id
        && request.resource.data.state == "closed";
    }

    function isOwnDeviceCreate() {
      return signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.businessNumber is string
        && request.resource.data.deviceNumber is string
        && request.resource.data.installId is string
        && request.resource.data.lastSeenAtServer == request.time
        && request.resource.data.status == "online";
    }

    function isOwnDeviceUpdate(deviceId) {
      return ownsDevice(deviceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.businessNumber == resource.data.businessNumber
        && request.resource.data.get("zookNumber", null) == resource.data.get("zookNumber", null)
        && request.resource.data.deviceNumber == resource.data.deviceNumber
        && request.resource.data.installId == resource.data.installId
        && request.resource.data.get("updateRing", null) == resource.data.get("updateRing", null)
        && request.resource.data.get("updatePaused", false) == resource.data.get("updatePaused", false)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastSeenAtServer"])
          || request.resource.data.lastSeenAtServer == request.time
        );
    }

    function isOwnDeviceMetadataUpdate(deviceId) {
      return ownsDevice(deviceId)
        && request.resource.data.businessNumber is string
        && request.resource.data.businessNumber.matches('^[0-9]{3}-[0-9]{2}-[0-9]{5}$')
        && request.resource.data.storeName is string
        && request.resource.data.storeName.size() > 0 && request.resource.data.storeName.size() <= 255
        && request.resource.data.deviceName is string
        && request.resource.data.deviceName.size() > 0 && request.resource.data.deviceName.size() <= 100
        && request.resource.data.storeNameSource in ["user", "default"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "businessNumber", "storeName", "storeNameSource", "deviceName", "updatedAt"
        ]);
    }

    function isCentralViewerDeviceUpdate() {
      return isCentralViewer()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["zookNumber"])
          || (request.resource.data.zookNumber is string && request.resource.data.zookNumber.matches('^([0-9]{8})?$')))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["contactPhone"])
          || !("contactPhone" in request.resource.data)
          || (request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() <= 40))
        && resource.data.ownerUid is string
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.businessNumber is string
        && request.resource.data.businessNumber.matches('^[0-9]{3}-[0-9]{2}-[0-9]{5}$')
        && request.resource.data.deviceNumber == resource.data.deviceNumber
        && request.resource.data.installId == resource.data.installId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "businessNumber",
          "zookNumber",
          "zookError",
          "storeName",
          "storeNameSource",
          "deviceName",
          "desktopName",
          "desktopNameOverride",
          "contactName",
          "contactPhone",
          "installLocation",
          "tags",
          "notes",
          "deletedAt",
          "status",
          "updatedAt",
          "updatePaused",
          "updateRing"
        ]);
    }

    function isOwnDeviceCommandCreate(deviceId) {
      return (isCentralViewer() || ownsDevice(deviceId))
        && request.resource.data.action is string
        && (ownsDevice(deviceId) || !deviceAccessLocked(deviceId)
          || request.resource.data.action.matches('^(device-access [a-f0-9-]{36}|refresh-status [a-f0-9-]{36}|request-update .*|request-rollback .*|wake-on-lan .*|configure-zook|sync-business-number|security-code [^ ]+ [0-9]{3} [0-9]{3})$')
          || (request.resource.data.get("sessionId", "") is string
            && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.get("sessionId", ""))).data.deviceId == deviceId
            && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.get("sessionId", ""))).data.ownerUid == request.auth.uid
            && protectedSessionAllows(deviceId, getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.get("sessionId", ""))).data)))
        && request.resource.data.state == "pending";
    }

    function ownsSecureChallenge() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isOwnSecureChallengeCreate() {
      return isCentralViewer()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.deviceId is string
        && deviceDoc(request.resource.data.deviceId).data.ownerUid is string
        && request.resource.data.challengeId is string
        && request.resource.data.code is string
        && request.resource.data.state == "pending";
    }

    function isOwnSecureChallengeUpdate() {
      return ownsSecureChallenge()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.challengeId == resource.data.challengeId
        && request.resource.data.code == resource.data.code
        && request.resource.data.state in ["used", "expired"];
    }

    function isOwnSessionFileCreate(sessionId) {
      return ownsSession(sessionId)
        && request.resource.data.sender == "viewer"
        && request.resource.data.target == "agent"
        && request.resource.data.filename is string
        && request.resource.data.transferId is string
        && request.resource.data.totalBytes is number
        && request.resource.data.totalBytes <= 500 * 1024 * 1024
        && (
          (
            request.resource.data.keys().hasOnly([
              "createdAt",
              "delivery",
              "fileData",
              "fileSha256",
              "filename",
              "isLast",
              "sender",
              "storagePath",
              "target",
              "totalBytes",
              "totalChunks",
              "transferId"
            ])
            &&
            request.resource.data.delivery == "firebase-storage"
            && request.resource.data.fileData == ""
            && request.resource.data.storagePath is string
            && request.resource.data.isLast == true
            && request.resource.data.totalChunks == 1
          ) ||
          (
            request.resource.data.keys().hasOnly([
              "chunkIndex",
              "chunkSha256",
              "createdAt",
              "delivery",
              "fileData",
              "fileSha256",
              "filename",
              "isLast",
              "sender",
              "target",
              "totalBytes",
              "totalChunks",
              "transferId"
            ])
            &&
            request.resource.data.delivery == "firestore-direct"
            && request.resource.data.fileData is string
            && request.resource.data.fileData.size() <= 128 * 1024
          )
        );
    }

    match /devices/{deviceId} {
      allow get: if isCentralViewer() || (signedIn()
        && (
          !exists(/databases/$(database)/documents/devices/$(deviceId))
          || resource.data.ownerUid == request.auth.uid
        ));
      allow list: if isCentralViewer() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isOwnDeviceCreate();
      allow update: if isCentralViewerDeviceUpdate() || isOwnDeviceUpdate(deviceId) || isOwnDeviceMetadataUpdate(deviceId);
      allow delete: if isCentralViewer() && !deviceAccessLocked(deviceId);

      match /commands/{commandId} {
        allow create: if isOwnDeviceCommandCreate(deviceId);
        allow read: if isCentralViewer() || ownsDevice(deviceId);
        allow update: if ownsDevice(deviceId);
        allow delete: if isCentralViewer();
      }
    }

    match /deviceAccessLocks/{deviceId} {
      allow read: if ownsDevice(deviceId);
      allow create, update: if ownsDevice(deviceId)
        && request.resource.data.keys().hasOnly(["enabled", "version", "updatedAt"])
        && request.resource.data.enabled is bool
        && request.resource.data.version is string
        && request.resource.data.version.size() == 36
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /deviceAccessRequests/{requestId} {
      allow create: if isCentralViewer()
        && request.resource.data.keys().hasOnly(["id", "deviceId", "ownerUid", "operation", "sessionId", "lockVersion", "key", "iv", "ciphertext", "state", "createdAt"])
        && request.resource.data.id == requestId && requestId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.deviceId is string
        && request.resource.data.operation in ["connect", "set", "disable", "reset"]
        && request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 200
        && request.resource.data.lockVersion is string && request.resource.data.lockVersion.size() <= 64
        && request.resource.data.key is string && request.resource.data.key.size() <= 400
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 32
        && request.resource.data.ciphertext is string && request.resource.data.ciphertext.size() <= 2048
        && request.resource.data.state == "pending" && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || ownsDevice(resource.data.deviceId));
      allow update: if ownsDevice(resource.data.deviceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state", "approvedVersion", "approvalSignature", "error", "updatedAt"])
        && resource.data.state == "pending" && request.resource.data.state in ["approved", "denied"]
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.state == "pending";
    }

    match /configuration/{configId} {
      allow read: if signedIn();
      allow create, update: if isCentralViewer()
        && configId == "updateRollout"
        && request.resource.data.targetVersion is string
        && request.resource.data.stage in ["canary", "pilot", "general"]
        && request.resource.data.percentage is number
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100
        && (!('targetDeviceIds' in request.resource.data)
          || request.resource.data.targetDeviceIds == null
          || (request.resource.data.targetDeviceIds is list
            && request.resource.data.targetDeviceIds.size() <= 200
            && request.resource.data.percentage == 0
            && request.resource.data.stage == "general"));
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if canReadSession();
      allow update: if isOwnSessionClose(sessionId);
      allow create: if isOwnSessionCreate(sessionId);
      allow delete: if false;

      match /chat/{messageId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }

      match /clipboard/{clipboardId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }

      match /files/{fileId} {
        allow read, delete: if canAccessSession(sessionId);
        allow create: if isOwnSessionFileCreate(sessionId);
        allow update: if false;
      }

      match /tileFrames/{frameId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }

      match /fileReceipts/{transferId} {
        allow read, create, update: if canAccessSession(sessionId);
        allow delete: if false;
      }

      match /webrtc/{signalId} {
        allow read, create, update, delete: if canAccessSession(sessionId);
      }

      match /viewerCandidates/{candidateId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }

      match /agentCandidates/{candidateId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }
    }

    match /secureChallenges/{challengeId} {
      allow create: if isOwnSecureChallengeCreate();
      allow read: if ownsSecureChallenge();
      allow update: if isOwnSecureChallengeUpdate();
      allow delete: if false;
    }
  }
}
