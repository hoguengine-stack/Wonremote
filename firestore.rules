rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCentralViewer() {
      return signedIn()
        && request.auth.uid in [
          "Xjjdvk0Nx1eqCvND4yIOHbM53tl1"
        ];
    }

    function deviceDoc(deviceId) {
      return get(/databases/$(database)/documents/devices/$(deviceId));
    }

    function ownsDevice(deviceId) {
      return signedIn() && deviceDoc(deviceId).data.ownerUid == request.auth.uid;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function ownsSession(sessionId) {
      return signedIn() && sessionDoc(sessionId).data.ownerUid == request.auth.uid;
    }

    function canAccessSession(sessionId) {
      return signedIn()
        && (
          sessionDoc(sessionId).data.ownerUid == request.auth.uid
          || (
            sessionDoc(sessionId).data.deviceId is string
            && deviceDoc(sessionDoc(sessionId).data.deviceId).data.ownerUid == request.auth.uid
          )
        );
    }

    function canReadSession() {
      return signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || (
            resource.data.deviceId is string
            && deviceDoc(resource.data.deviceId).data.ownerUid == request.auth.uid
          )
        );
    }

    function isOwnSessionCreate(sessionId) {
      return signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == sessionId
        && request.resource.data.deviceId is string
        && request.resource.data.state == "connected"
        && isCentralViewer()
        && deviceDoc(request.resource.data.deviceId).data.ownerUid is string;
    }

    function isOwnSessionClose(sessionId) {
      return ownsSession(sessionId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.id == resource.data.id
        && request.resource.data.state == "closed";
    }

    function isOwnDeviceCreate() {
      return signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.businessNumber is string
        && request.resource.data.deviceNumber is string
        && request.resource.data.installId is string
        && request.resource.data.status == "online";
    }

    function isOwnDeviceUpdate(deviceId) {
      return ownsDevice(deviceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.businessNumber == resource.data.businessNumber
        && request.resource.data.deviceNumber == resource.data.deviceNumber
        && request.resource.data.installId == resource.data.installId
        && request.resource.data.get("updateRing", null) == resource.data.get("updateRing", null)
        && request.resource.data.get("updatePaused", false) == resource.data.get("updatePaused", false);
    }

    function isCentralViewerDeviceUpdate() {
      return isCentralViewer()
        && resource.data.ownerUid is string
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.businessNumber == resource.data.businessNumber
        && request.resource.data.deviceNumber == resource.data.deviceNumber
        && request.resource.data.installId == resource.data.installId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "storeName",
          "storeNameSource",
          "deviceName",
          "desktopName",
          "deletedAt",
          "status",
          "updatedAt",
          "updatePaused",
          "updateRing"
        ]);
    }

    function isOwnDeviceCommandCreate(deviceId) {
      return (isCentralViewer() || ownsDevice(deviceId))
        && request.resource.data.action is string
        && request.resource.data.state == "pending";
    }

    function ownsSecureChallenge() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isOwnSecureChallengeCreate() {
      return isCentralViewer()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.deviceId is string
        && deviceDoc(request.resource.data.deviceId).data.ownerUid is string
        && request.resource.data.challengeId is string
        && request.resource.data.code is string
        && request.resource.data.state == "pending";
    }

    function isOwnSecureChallengeUpdate() {
      return ownsSecureChallenge()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.challengeId == resource.data.challengeId
        && request.resource.data.code == resource.data.code
        && request.resource.data.state in ["used", "expired"];
    }

    function isOwnSessionFileCreate(sessionId) {
      return ownsSession(sessionId)
        && request.resource.data.sender == "viewer"
        && request.resource.data.target == "agent"
        && request.resource.data.filename is string
        && request.resource.data.transferId is string
        && request.resource.data.totalBytes is number
        && request.resource.data.totalBytes <= 500 * 1024 * 1024
        && (
          (
            request.resource.data.keys().hasOnly([
              "createdAt",
              "delivery",
              "fileData",
              "fileSha256",
              "filename",
              "isLast",
              "sender",
              "storagePath",
              "target",
              "totalBytes",
              "totalChunks",
              "transferId"
            ])
            &&
            request.resource.data.delivery == "firebase-storage"
            && request.resource.data.fileData == ""
            && request.resource.data.storagePath is string
            && request.resource.data.isLast == true
            && request.resource.data.totalChunks == 1
          ) ||
          (
            request.resource.data.keys().hasOnly([
              "chunkIndex",
              "chunkSha256",
              "createdAt",
              "delivery",
              "fileData",
              "fileSha256",
              "filename",
              "isLast",
              "sender",
              "target",
              "totalBytes",
              "totalChunks",
              "transferId"
            ])
            &&
            request.resource.data.delivery == "firestore-direct"
            && request.resource.data.fileData is string
            && request.resource.data.fileData.size() <= 128 * 1024
          )
        );
    }

    match /devices/{deviceId} {
      allow get: if isCentralViewer() || (signedIn()
        && (
          !exists(/databases/$(database)/documents/devices/$(deviceId))
          || resource.data.ownerUid == request.auth.uid
        ));
      allow list: if isCentralViewer() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isOwnDeviceCreate();
      allow update: if isCentralViewerDeviceUpdate() || isOwnDeviceUpdate(deviceId);
      allow delete: if isCentralViewer();

      match /commands/{commandId} {
        allow create: if isOwnDeviceCommandCreate(deviceId);
        allow read: if isCentralViewer() || ownsDevice(deviceId);
        allow update: if ownsDevice(deviceId);
        allow delete: if isCentralViewer();
      }
    }

    match /configuration/{configId} {
      allow read: if signedIn();
      allow create, update: if isCentralViewer()
        && configId == "updateRollout"
        && request.resource.data.targetVersion is string
        && request.resource.data.stage in ["canary", "pilot", "general"]
        && request.resource.data.percentage is number
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100;
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if canReadSession();
      allow update: if isOwnSessionClose(sessionId);
      allow create: if isOwnSessionCreate(sessionId);
      allow delete: if false;

      match /chat/{messageId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }

      match /clipboard/{clipboardId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }

      match /files/{fileId} {
        allow read, delete: if canAccessSession(sessionId);
        allow create: if isOwnSessionFileCreate(sessionId);
        allow update: if false;
      }

      match /tileFrames/{frameId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }

      match /fileReceipts/{transferId} {
        allow read, create, update: if canAccessSession(sessionId);
        allow delete: if false;
      }

      match /webrtc/{signalId} {
        allow read, create, update, delete: if canAccessSession(sessionId);
      }

      match /viewerCandidates/{candidateId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }

      match /agentCandidates/{candidateId} {
        allow read, create, delete: if canAccessSession(sessionId);
        allow update: if false;
      }
    }

    match /secureChallenges/{challengeId} {
      allow create: if isOwnSecureChallengeCreate();
      allow read: if ownsSecureChallenge();
      allow update: if isOwnSecureChallengeUpdate();
      allow delete: if false;
    }
  }
}
