<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.wonremote.permission.CONTROL_ADDON"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.wonremote.permission.CONTROL_ADDON" />

    <application>
        <service
            android:name="com.wonremote.agent.WonRemoteAccessibilityService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/wonremote_control_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/wonremote_accessibility_service" />
        </service>
    </application>
</manifest>
