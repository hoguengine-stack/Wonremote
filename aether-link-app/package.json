{
  "name": "wonremote-app",
  "version": "0.1.63",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "tsx src/agent/index.ts",
    "agent:watch": "tsx src/agent/index.ts --watch",
    "agent:install": "tsx src/agent/index.ts --install",
    "agent:uninstall": "tsx src/agent/index.ts --uninstall",
    "api": "tsx src/server/index.ts",
    "dev": "vite --host 127.0.0.1",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev",
    "agent:package": "node scripts/package-agent.js",
    "release:keypair": "node scripts/generate-update-keypair.js",
    "release:manifest": "node scripts/create-update-manifest.js",
    "release:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-github-release.ps1",
    "firebase:deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-firebase.ps1",
    "firebase:deploy:spark": "powershell -ExecutionPolicy Bypass -File scripts/deploy-firebase.ps1 -SparkOnly",
    "firebase:deploy:spark:no-storage": "powershell -ExecutionPolicy Bypass -File scripts/deploy-firebase.ps1 -SparkOnly -SkipStorage",
    "firebase:verify": "node scripts/verify-firebase-deploy-readiness.js",
    "firebase:rules:test": "npx firebase-tools emulators:exec --only firestore --project wonremote-a7fd3 \"node scripts/verify-firestore-rules.mjs\"",
    "release:exes": "node scripts/package-release-exes.js && node scripts/verify-x86-installer-payloads.js",
    "release:verify-payloads": "node scripts/verify-x86-installer-payloads.js",
    "build": "node scripts/build-app.js",
    "test": "vitest run",
    "test:update-e2e": "tsx tests/e2e/test_installer_update_flow.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@tauri-apps/api": "^2.11.0",
    "firebase": "^12.14.0",
    "lucide-react": "^0.468.0",
    "node-datachannel": "^0.32.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "werift": "^0.23.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "playwright": "^1.60.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "ip": "npm:neoip@2.1.0"
  }
}
